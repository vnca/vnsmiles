---
import { Image } from 'astro:assets';
import HomeHeroImage from '../assets/about-vn-ca.webp';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
			}
			.hero-image img {
				display: block;
				width: 100%;
				margin: 1.5em 0;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.button {
				display: inline-block;
				background: var(--accent);
				color: #fff;
				padding: 0.6em 1.4em;
				border-radius: 999px;
				text-decoration: none;
				font-weight: 700;
			}
			.button:hover {
				background: var(--accent-dark);
				color: #fff;
			}
			.about-link {
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>VNSMILES</h1>
				<div class="hero-image">
					<Image
						width={1020}
						height={510}
						src={HomeHeroImage}
						alt="Cờ Việt Nam và cờ Canada"
					/>
				</div>
				<p>
					Có những chuyện không biết nên kể với ai, mà giữ trong đầu thì sợ lại quên mất.
				</p>
				<p>
					Nên mình viết ra đây. Toàn chuyện đời thường ở hai nơi mình đã sống, Canada và Việt
					Nam. Có gì thì viết đó như một bản ghi nhớ cá nhân, không có chuyện thì thôi. Cũng
					không có lịch đăng bài hay chủ đề cụ thể nào cả đâu.
				</p>
				<p>
					Có gì viết nấy nhé!
				</p>
				<p>
					<a class="button" href="/blog">Bắt đầu đọc</a>
				</p>
				<p class="about-link">
					Muốn biết thêm về người viết thì ghé <a href="/about">Về người viết</a>.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
